{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run build:web",
  "outputDirectory": "artifacts/villabooks-bali/dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/contact", "destination": "/get-started", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/gateway?__gateway=:path*" },
    { "source": "/blog", "destination": "/api/gateway?__document=blog" },
    { "source": "/blog/:path*", "destination": "/api/gateway?__document=blog/:path*" },
    { "source": "/sitemap.xml", "destination": "/api/gateway?__document=sitemap.xml" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
